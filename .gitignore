# Python environment (conda env "affordance3d", see requirements.txt)
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.virtual_documents/

# Local datasets, third-party checkouts and experiment outputs are not versioned.
# Leading slashes keep these from matching the tracked docs/outputs/ folder.
/data/
/third_party/
/runs/
# On the server these are symlinks into the NAS work dir (a trailing slash would not match a symlink).
/data
/runs
/report/assets

# Third-party preview images are fetched with scripts/download_report_images.sh and not
# redistributed here. Videos made by our own notebooks are small and tracked in report/media/.
/report/assets/

.DS_Store
