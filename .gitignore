# Python caches, local virtual environments, coverage and notebook scratch
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.coverage
.ipynb_checkpoints/
.virtual_documents/
.DS_Store

# Data, third-party checkouts and experiment outputs are not versioned (leading slashes keep the tracked
# docs/outputs/ out of these rules; no trailing slash, so symlinks match too):
# - on the server, data, runs and report/assets are symlinks into the NAS work dir;
# - on a Mac, third_party holds the LIBERO-PRO checkout and runs the rollout logs fetched for local
#   simulation (scripts/local/fetch_sim_data.sh).
/data
/runs
/third_party
/report/assets
# Third-party preview images are fetched into report/assets by scripts/report/download_report_images.sh
# and not redistributed here. Videos and figures made by our own notebooks are tracked in report/media/.
